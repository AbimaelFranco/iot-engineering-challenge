# Plantilla de variables de entorno. Copiar a ".env" y rellenar con los valores reales.
# ".env" esta en .gitignore y nunca debe subirse al repositorio.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Misma base de datos que usa backend/telemetry-worker.py (ver backend/.env)
DATABASE_URL=postgresql://user:password@host/dbname

# Mismo broker HiveMQ que usa backend/telemetry-worker.py (ver backend/.env.example),
# pero con una credencial PROPIA con permiso de Publish: telemetry_worker
# (la de backend/.env) es solo de suscripcion, para guardar MQTT -> DB. El
# dashboard publica en el topic config/<node_id> (ver Documentation/README.md);
# usar tambien un MQTT_CLIENT_ID propio para no colisionar con el
# client_id del logger/subscriptor.
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=dashboard_config_publisher
