# Plantilla de variables de entorno. Copiar a ".env" y rellenar con los valores reales.
# ".env" esta en .gitignore y nunca debe subirse al repositorio.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Misma base de datos que usa backend/telemetry-worker.py (ver backend/.env)
DATABASE_URL=postgresql://user:password@host/dbname
